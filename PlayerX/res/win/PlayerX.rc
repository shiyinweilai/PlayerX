// PlayerX Windows 资源脚本
// 通过 windres/llvm-rc 编译为 .o 后链接到 EXE，
// 让 Windows 在 PE 加载阶段读取 manifest 声明的 DPI Awareness。
// 这是相对运行期 API 调用 SetProcessDpiAwarenessContext 更可靠的方式 ——
// 一些 mingw 交叉编译 + GUI 子系统下，运行期 API 可能因 user32 早期固化
// 而无法生效，造成 DWM 对窗口做 bilinear 二次拉伸 → 文字毛边。
// manifest 在加载阶段生效，无任何时序问题。
#include <winuser.h>

// CREATEPROCESS_MANIFEST_RESOURCE_ID = 1
// RT_MANIFEST = 24
1 24 "PlayerX.manifest"
